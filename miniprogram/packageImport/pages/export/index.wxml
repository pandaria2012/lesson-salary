<!-- 导出月报（分包页面） -->
<view class="page">
  <view class="page-head">
    <text class="title">导出月报</text>
  </view>

  <view style="height:12px"></view>

  <view class="card summary-card">
    <view class="sum-main">
      {{month}} 收入
      <text class="amount">¥{{totalAmount}}</text>
    </view>
    <view class="sum-sub">
      <text>课时 {{totalHours}}</text>
      <text>有效 {{totalCount}} 课次</text>
    </view>
  </view>

  <view wx:if="{{groupRows.length > 0}}" class="card">
    <view class="sec-title" style="font-size:15px;font-weight:600;margin-bottom:8px">按学生</view>
    <view class="group-row" wx:for="{{groupRows}}" wx:key="label">
      <view class="g-left">
        <text>{{item.label}}</text>
        <text class="muted">{{item.sub}}</text>
      </view>
      <text class="g-right">{{item.amount}}</text>
    </view>
  </view>

  <view wx:else class="empty">当月暂无记录</view>

  <view class="btn block" style="margin-top:12px" bindtap="onExport">{{busy ? '生成中…' : '生成并导出 Excel'}}</view>
  <view class="muted" style="margin-top:8px">导出后可点右上角菜单转发到聊天，或用其他应用打开。</view>
</view>
