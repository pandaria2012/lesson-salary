/* 记录页：补录浮动按钮（对应 Web 端 .fab） */
.fab {
  position: fixed;
  right: 20px;
  bottom: calc(24px + env(safe-area-inset-bottom, 0px));
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 96px;
  height: 48px;
  padding: 0 18px;
  border-radius: 999px;
  background: var(--primary);
  color: #fff;
  font-size: 16px;
  white-space: nowrap;
  box-shadow: 0 4px 12px rgba(0, 0, 0, .2);
}
