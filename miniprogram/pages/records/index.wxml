<!-- 上课记录：对应 Web 端 src/web/pages/RecordsPage.tsx -->
<view class="page">
  <view class="page-head">
    <text class="title">上课记录</text>
  </view>

  <month-picker month="{{month}}" bind:change="onMonthChange" />

  <!-- 工具栏 -->
  <view class="toolbar">
    <view class="chip {{view === 'list' ? 'active' : ''}}" data-view="list" bindtap="onViewChange">列表</view>
    <view class="chip {{view === 'calendar' ? 'active' : ''}}" data-view="calendar" bindtap="onViewChange">日历</view>
    <block wx:if="{{view === 'list'}}">
      <view class="chip {{groupBy === 'day' ? 'active' : ''}}" data-by="day" bindtap="onGroupByChange">按天</view>
      <view class="chip {{groupBy === 'course' ? 'active' : ''}}" data-by="course" bindtap="onGroupByChange">按课程</view>
      <view class="chip {{groupBy === 'student' ? 'active' : ''}}" data-by="student" bindtap="onGroupByChange">按学生</view>
    </block>
  </view>

  <!-- 筛选 -->
  <view class="filters">
    <picker class="filter-item" range="{{studentFilterOptions}}" range-key="label" value="{{studentFilterIndex}}" bindchange="onStudentFilter">
      <view class="filter-value">{{studentFilterOptions[studentFilterIndex].label}}</view>
    </picker>
    <picker class="filter-item" range="{{courseFilterOptions}}" range-key="label" value="{{courseFilterIndex}}" bindchange="onCourseFilter">
      <view class="filter-value">{{courseFilterOptions[courseFilterIndex].label}}</view>
    </picker>
    <picker class="filter-item" range="{{statusFilterOptions}}" range-key="label" value="{{statusFilterIndex}}" bindchange="onStatusFilter">
      <view class="filter-value">{{statusFilterOptions[statusFilterIndex].label}}</view>
    </picker>
    <view wx:if="{{hasFilter}}" class="clear-btn" bindtap="onClearFilters">清除</view>
  </view>
  <view wx:if="{{hasFilter}}" class="muted" style="margin:-4px 0 8px;font-size:13px">筛选结果：{{filteredCount}} 条</view>

  <!-- 列表视图 -->
  <block wx:if="{{view === 'list'}}">
    <view wx:for="{{groups}}" wx:key="key" class="record-group">
      <view class="group-head">
        <text class="g-title">{{item.label}}</text>
        <text class="muted">{{item.sub}}</text>
      </view>
      <view wx:for="{{item.rows}}" wx:for-item="row" wx:key="id" class="card record {{row.isCancelled ? 'cancelled' : ''}}">
        <view class="rec-top">
          <text class="rec-time">{{row.date}} {{row.time}}</text>
          <text class="rec-amount">{{row.amount}}</text>
        </view>
        <view class="rec-sub">{{row.student}} · {{row.courseTypeName}}</view>
        <view wx:if="{{row.isCancelled}}" class="rec-cancel">已取消</view>
        <view class="btn-row">
          <view class="btn ghost" data-id="{{row.id}}" bindtap="onEdit">编辑</view>
          <view class="btn muted-btn" data-id="{{row.id}}" bindtap="onToggleCancel">{{row.isCancelled ? '恢复' : '取消'}}</view>
          <view class="btn danger" data-id="{{row.id}}" bindtap="onDelete">删除</view>
        </view>
      </view>
    </view>
    <view wx:if="{{groups.length === 0}}" class="empty">{{emptyText}}</view>
  </block>

  <!-- 日历视图 -->
  <block wx:else>
    <view class="card calendar">
      <view class="cal-week">
        <text class="wk">一</text><text class="wk">二</text><text class="wk">三</text>
        <text class="wk">四</text><text class="wk">五</text><text class="wk">六</text><text class="wk">日</text>
      </view>
      <view class="cal-grid">
        <view
          wx:for="{{calCells}}"
          wx:key="index"
          class="cal-cell {{item.isToday ? 'today' : ''}}"
          data-date="{{item.date}}"
          bindtap="onSelectDay"
        >
          <block wx:if="{{item.day}}">
            <text class="cal-day">{{item.day}}</text>
            <view class="cal-info">
              <text wx:if="{{item.amount}}" class="cal-amount">{{item.amount}}</text>
              <text wx:if="{{item.count > 0}}" class="cal-count">{{item.count}}课</text>
              <text wx:if="{{item.cancelledCount > 0}}" class="cal-count cancelled">取消{{item.cancelledCount}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>
  </block>

  <!-- 补录浮动按钮 -->
  <view class="fab" bindtap="onAdd">＋ 补录</view>
</view>

<!-- 当天明细 -->
<sheet open="{{detailOpen}}" title="{{detailTitle}}" bind:close="onCloseDetail">
  <view wx:if="{{detailRows.length === 0}}" class="muted">当天没有记录</view>
  <view wx:else>
    <view class="group-row" wx:for="{{detailRows}}" wx:key="id">
      <text>{{item.text}}</text>
    </view>
  </view>
</sheet>

<!-- 补录 / 编辑表单 -->
<sheet open="{{formOpen}}" title="{{formTitle}}" bind:close="onCloseForm">
  <view class="field">
    <text class="label">日期</text>
    <picker mode="date" value="{{form.date}}" bindchange="onFormDate">
      <view class="picker-value">{{form.date}}</view>
    </picker>
  </view>

  <view class="field">
    <text class="label">时间段</text>
    <view class="row2">
      <picker mode="time" value="{{form.startTime}}" bindchange="onFormStart">
        <view class="picker-value">{{form.startTime || '开始'}}</view>
      </picker>
      <picker mode="time" value="{{form.endTime}}" bindchange="onFormEnd">
        <view class="picker-value">{{form.endTime || '结束'}}</view>
      </picker>
    </view>
  </view>

  <view class="duration-chips">
    <view class="chip" data-hours="1" bindtap="onFormDuration">1 小时</view>
    <view class="chip" data-hours="1.5" bindtap="onFormDuration">1.5 小时</view>
    <view class="chip" data-hours="2" bindtap="onFormDuration">2 小时</view>
    <view class="chip" data-hours="2.5" bindtap="onFormDuration">2.5 小时</view>
    <view class="chip" data-hours="3" bindtap="onFormDuration">3 小时</view>
  </view>

  <view class="field">
    <text class="label">学生</text>
    <input class="input" value="{{form.student}}" placeholder="学生姓名" bindinput="onFormStudent" />
  </view>

  <view class="field">
    <text class="label">课程类型</text>
    <picker range="{{courseTypeOptions}}" range-key="label" value="{{courseTypeIndex}}" bindchange="onFormCourseType">
      <view class="picker-value">{{form.courseTypeName || '请选择'}}</view>
    </picker>
  </view>

  <view class="row2">
    <view class="field">
      <text class="label">时薪（元/小时）</text>
      <input class="input" type="digit" value="{{form.rate}}" placeholder="如 200" bindinput="onFormRate" />
    </view>
    <view class="field">
      <text class="label">课时（小时）</text>
      <input class="input" type="digit" value="{{form.hours}}" placeholder="如 2" bindinput="onFormHours" />
    </view>
  </view>

  <view class="field">
    <text class="label">备注</text>
    <input class="input" value="{{form.note}}" placeholder="可选" bindinput="onFormNote" />
  </view>

  <view class="field">
    <text class="label">状态</text>
    <view class="picker-value" bindtap="onToggleFormStatus">{{form.status === 'normal' ? '正常（计薪）' : '已取消（不计薪）'}}</view>
  </view>

  <view class="btn-row">
    <view class="btn ghost" bindtap="onCloseForm">取消</view>
    <view class="btn" bindtap="onSave">{{busy ? '保存中…' : '保存'}}</view>
  </view>
</sheet>
