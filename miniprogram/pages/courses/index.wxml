<!-- 课程类型：对应 Web 端 src/web/pages/CourseTypesPage.tsx -->
<view class="page">
  <view class="page-head">
    <text class="title">课程类型</text>
    <view class="btn" style="min-height:40px;padding:0 16px" bindtap="onAdd">新增</view>
  </view>

  <view style="height:12px"></view>

  <view wx:for="{{rows}}" wx:key="id" class="card">
    <view>
      <text style="font-weight:600">{{item.name}}</text>
      <text wx:if="{{item.type}}" class="tag">{{item.type}}</text>
      <text class="tag {{item.statusClass}}">{{item.statusLabel}}</text>
    </view>
    <view class="muted" style="margin-top:4px">{{item.defaults}}</view>
    <view class="btn-row">
      <view class="btn ghost" data-id="{{item.id}}" bindtap="onEdit">编辑</view>
      <view class="btn danger" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onDelete">删除</view>
    </view>
  </view>

  <view wx:if="{{rows.length === 0}}" class="empty">还没有课程类型，点右上角「新增」创建。</view>
</view>

<!-- 新增 / 编辑表单 -->
<sheet open="{{formOpen}}" title="{{formTitle}}" bind:close="onCloseForm">
  <view class="field">
    <text class="label">名称</text>
    <input class="input" value="{{form.name}}" placeholder="如 初三数学1对1" bindinput="onFormName" />
  </view>

  <view class="field">
    <text class="label">教学形式</text>
    <input class="input" value="{{form.type}}" placeholder="如 一对一 / 小班 / 线上" bindinput="onFormType" />
  </view>

  <view class="row2">
    <view class="field">
      <text class="label">默认课时（小时）</text>
      <input class="input" type="digit" value="{{form.defaultHours}}" placeholder="如 2" bindinput="onFormHours" />
    </view>
    <view class="field">
      <text class="label">默认时薪（元/小时）</text>
      <input class="input" type="digit" value="{{form.defaultRate}}" placeholder="如 200" bindinput="onFormRate" />
    </view>
  </view>

  <view class="field">
    <text class="label">状态</text>
    <view class="picker-value" bindtap="onToggleStatus">{{form.status === 'enabled' ? '启用' : '停用'}}</view>
  </view>

  <view class="btn-row">
    <view class="btn ghost" bindtap="onCloseForm">取消</view>
    <view class="btn" bindtap="onSave">{{busy ? '保存中…' : '保存'}}</view>
  </view>
</sheet>
