{
  "name": "lesson-salary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:core": "node scripts/build-core.mjs",
    "check:core": "node scripts/check-core-sync.mjs",
    "check:mp": "python scripts/check-mp-structure.py && python scripts/check-mp-bindings.py && python scripts/check-mp-nav.py",
    "verify": "npm run check:core && npm run check:mp && npm test && tsc --noEmit && tsc -p miniprogram/tsconfig.json --noEmit",
    "verify:all": "npm run verify && npm run test:e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fake-indexeddb": "^6.0.0",
    "miniprogram-api-typings": "^5.2.3",
    "miniprogram-automator": "^0.12.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.1",
    "wrangler": "^4.120.0"
  }
}
